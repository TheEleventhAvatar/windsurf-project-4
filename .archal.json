{
  "name": "GitHub Reliability Torture Suite",
  "description": "Production-grade reliability testing for agent workflows using Vitest + Archal",
  "type": "vitest",
  "test": {
    "command": "npm test",
    "timeout": 30000,
    "env": {
      "ARCHAL_TOKEN": "{{.TwinToken}}",
      "ARCHAL_GITHUB_API": "{{.TwinAPI}}/github/api"
    }
  },
  "scenarios": [
    "scenarios/concurrent-merge-race.md",
    "scenarios/retry-storm.md",
    "scenarios/stale-state-drift.md",
    "scenarios/permission-drift.md"
  ],
  "twins": [
    {
      "type": "github",
      "seed": "small-project"
    }
  ]
}
